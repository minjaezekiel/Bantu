# Local dev artifacts
*.db
*.db-wal
*.db-shm
/node_modules
.env
.env.local
.DS_Store
__pycache__/
*.log

# Build artifacts (regenerate with: cd bantu-src/compiler && ./build.sh)
bantu-src/compiler/build/

# Windows deps cache (downloaded by win-deps/fetch-deps.sh on demand)
win-deps/
# Distribution output (built by scripts/pack-windows.sh)
dist/

# Editor / OS junk
*.swp
*.swo
*~
.idea/
.vscode/.rope*

# v1.2.1 — VSCode extension build output
vscode-extension/out/
vscode-extension/node_modules/
vscode-extension/*.vsix

# v1.2.1 — Windows installer build output
dist/
vscode-extension/package-lock.json

# PG-enabled local build (kept separate so default build is unaffected)
bantu-src/compiler/build_pg/
# Sample PROJECTS (blogsite, webrtc-chat, ...) carry databases, node_modules
# and build output, so the directory is ignored wholesale. The package
# galleries are different: tests/run_samples.sh executes every one of them in
# CI, which it can only do if they are actually in the repository. They were
# not -- `samples` ignored the directory, so git never descended into it and
# samples/numba/ was silently dropped from every commit that claimed to add it.
samples/*
!samples/numba/
!samples/bplot/
# [found] This line used to read `samples/webrtc-chat/server.b` -- with no `!`,
# so it ADDED an ignore rule for the one file it was meant to keep. The mistake
# was invisible because server.b was already tracked and .gitignore does not
# affect tracked files, while every NEW file in the sample -- public/app.js,
# public/styles.css, tls-dev-proxy.py -- was ignored by `samples/*` and would
# have been dropped from the commit that claimed to add them. The page would
# have arrived in the repository referencing a stylesheet and a script that
# were not there. This is the same silent loss the note above records for
# samples/numba/, so the whole directory is re-included; the databases, logs
# and secrets the note worries about are already covered by the global rules
# above and below (*.db, *.log, vapid.json, subscriptions.db).
!samples/webrtc-chat/
# samples/one-taylor needs the same re-include, for the same reason the notes
# above record twice: `samples/*` stops git descending into the directory, so
# every file in a new sample is silently dropped from the commit that claims to
# add it. The uploads directory, the SQLite file and the node/next build output
# are excluded below; the trained model and its vocabulary are kept, because
# without them the sample cannot run without a twelve-minute training session.
!samples/one-taylor/
samples/one-taylor/backend/uploads/*
!samples/one-taylor/backend/uploads/.gitkeep
# The derived-key root. Never committed: every key in the app descends from it.
samples/one-taylor/.secrets.env
samples/one-taylor/web/node_modules/
samples/one-taylor/web/.next/
samples/one-taylor/web/next-env.d.ts
samples/one-taylor/web/*.tsbuildinfo
# An operator's own lexicon terms are theirs, and must not end up in a public
# diff. The README in that directory explains why the shipped files are nearly
# empty.
samples/one-taylor/backend/safety/lexicons/*.txt
!samples/one-taylor/backend/safety/lexicons/slur.txt

# Web Push secrets — a VAPID private key must never be committed. Replacing it
# silently invalidates every push subscription a browser has already created.
vapid.json
**/vapid.json
push_subscriptions.db
subscriptions.db
# Code signing secrets — DO NOT COMMIT
*.key
*.pfx
*.crt
bantu-codesign.*
